# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR) and fill in values.
ukg_ready:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      database: wagway_prod   # models land in <database>.SILVER and <database>.GOLD
      schema: dbt_default     # unused by models (custom schemas are used verbatim)
      threads: 4
